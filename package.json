{
  "name": "pilates",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:admin": "pnpm --filter @pilates/admin-web dev",
    "dev:backend": "pnpm --filter @pilates/backend start:dev",
    "dev:mobile": "pnpm --filter @pilates/mobile start",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
