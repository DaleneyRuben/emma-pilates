{
  "name": "pilates",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:api": "pnpm generate:api && git diff --exit-code -- apps/backend/openapi/openapi.json packages/api-contracts/src/generated && test -z \"$(git ls-files --others --exclude-standard -- apps/backend/openapi packages/api-contracts/src/generated)\"",
    "dev:admin": "pnpm --filter @pilates/admin-web dev",
    "dev:backend": "pnpm --filter @pilates/backend start:dev",
    "dev:mobile": "pnpm --filter @pilates/mobile start",
    "generate:api": "pnpm --filter @pilates/backend openapi:generate && pnpm --filter @pilates/api-contracts generate",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
