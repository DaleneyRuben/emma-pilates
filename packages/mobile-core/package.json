{
  "name": "@pilates/mobile-core",
  "version": "0.0.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/work-sans": "^0.4.2",
    "@hookform/resolvers": "^5.9.1",
    "@pilates/api-contracts": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "5.102.2",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "expo": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pilates/tooling": "workspace:*",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^10.12.0",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.9.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" jest.setup.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" jest.setup.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "<rootDir>/src/**/*.spec.ts?(x)"
    ]
  },
  "private": true
}
