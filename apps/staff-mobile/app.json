{
  "expo": {
    "name": "Emma Pilates Staff",
    "slug": "emma-pilates-staff",
    "scheme": "emmapilates-staff",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.emmapilates.staff",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:links.emmapilatesstudio.com"
      ]
    },
    "android": {
      "package": "com.emmapilates.staff",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "links.emmapilatesstudio.com",
              "pathPrefix": "/staff/authentication/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F3E9E7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "backgroundColor": "#F3E9E7",
          "resizeMode": "contain",
          "ios": {
            "imageWidth": 240
          },
          "android": {
            "imageWidth": 160
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permite que Emma Pilates Staff use Face ID para proteger tu sesi\u00f3n."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "updates"
        }
      ],
      "@pilates/mobile-core/launch-tap-plugin",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite que Emma Pilates Staff tome fotos de los comprobantes de transferencia.",
          "photosPermission": "Permite que Emma Pilates Staff elija fotos de los comprobantes de transferencia.",
          "microphonePermission": false
        }
      ],
      "@sentry/react-native/expo"
    ],
    "extra": {
      "eas": {
        "projectId": "885d3272-da0a-49f7-b8cd-33092de7662a"
      }
    },
    "owner": "emma-pilates",
    "updates": {
      "url": "https://u.expo.dev/885d3272-da0a-49f7-b8cd-33092de7662a"
    }
  }
}
