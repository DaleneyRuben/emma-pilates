{
  "name": "@pilates/client-mobile",
  "version": "0.0.0",
  "main": "index.ts",
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@pilates/api-contracts": "workspace:*",
    "@pilates/mobile-core": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/react-query": "5.102.2",
    "expo": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "react": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pilates/tooling": "workspace:*",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.9.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8081",
    "android": "expo start --android --port 8081",
    "ios": "expo start --ios --port 8081",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "release:smoke": "node ../../scripts/mobile-release-smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" App.tsx index.ts jest.setup.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" App.tsx index.ts jest.setup.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "<rootDir>/src/**/*.spec.ts?(x)"
    ],
    "fakeTimers": {
      "enableGlobally": true,
      "now": 1791468000000,
      "doNotFake": [
        "cancelAnimationFrame",
        "cancelIdleCallback",
        "clearImmediate",
        "clearInterval",
        "clearTimeout",
        "hrtime",
        "nextTick",
        "performance",
        "queueMicrotask",
        "requestAnimationFrame",
        "requestIdleCallback",
        "setImmediate",
        "setInterval",
        "setTimeout"
      ]
    }
  },
  "private": true
}
