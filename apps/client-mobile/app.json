{
  "expo": {
    "name": "Emma Pilates",
    "slug": "emma-pilates-client",
    "scheme": "emmapilates-client",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.emmapilates.client",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:links.emmapilatesstudio.com"
      ]
    },
    "android": {
      "package": "com.emmapilates.client",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "links.emmapilatesstudio.com",
              "pathPrefix": "/client/authentication/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F3E9E7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permite que Emma Pilates use Face ID para proteger tu sesión."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "updates"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Permite que Emma Pilates guarde el QR del estudio en tus fotos.",
          "granularPermissions": []
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@pilates/mobile-core/launch-tap-plugin",
      "@sentry/react-native/expo"
    ],
    "extra": {
      "eas": {
        "projectId": "c9271277-f815-4e36-97db-63a584a85957"
      }
    },
    "owner": "emma-pilates",
    "updates": {
      "url": "https://u.expo.dev/c9271277-f815-4e36-97db-63a584a85957"
    }
  }
}
