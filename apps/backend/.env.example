DATABASE_URL=postgresql://localhost:5433/emma_pilates
# Most connections one process (the API or the worker) holds across its one
# Prisma pool and its one pg-boss pool (2 to 20, default 10). The production
# Aiven database allows 20 connections, so Northflank sets 4 (ADR-0027).
# DATABASE_POOL_MAX=10
NODE_ENV=development
PORT=3100
# Exact admin-web origins allowed to send state-changing cookie requests
# (comma-separated, no wildcards; production requires explicit https origins).
ADMIN_WEB_TRUSTED_ORIGINS=http://localhost:5173
AUTHENTICATION_EMAIL_DIGEST_KEY=replace-with-at-least-32-random-characters
AUTHENTICATION_LINK_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AUTHENTICATION_LINK_ENCRYPTION_KEY_ID=local-development-v1
# Object storage (ADR-0088): local disk by default; production requires s3
# (Cloudflare R2). To try the S3 adapter locally against MinIO (testing guide):
# OBJECT_STORAGE=s3
# OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9100
# OBJECT_STORAGE_BUCKET=pilates-local
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE=local
UPLOADS_LOCAL_STORAGE_ROOT=.data/uploads

# The studio transfer QR image, the only transfer instruction (PAY-003); production must set it
TRANSFER_QR_IMAGE_PATH=.data/transfer-qr.png
# Referral reward in BOB centavos; only 6000 (Bs 60) is approved
REFERRAL_REWARD_CENTAVOS=6000

# Shared development database on Neon (EXT-003, ADR-0046): the direct, unpooled
# connection string from the Neon console (Connect, pooling off). Kept commented
# so local runs stay on DATABASE_URL; never commit the real value here.
# DEV_DATABASE_URL=

# Better Stack (ADR-0081, ADR-0066): both are credentials for the monitors, so
# the real values live only in your own .env and the host's environment. Unset,
# neither the API nor the worker reports errors, and the worker pings no
# heartbeat.
# ERROR_REPORTING_DSN=
# WORKER_HEARTBEAT_URL=

# Expo push (NOT-002): the access token from expo.dev, needed once the projects
# turn on enhanced push security. It is a credential: production keeps it in
# Northflank's `production` secret group. Unset, the worker sends without one.
# EXPO_ACCESS_TOKEN=

# The daily database backup (EXT-009, `pnpm backup:run`) reads DATABASE_URL and
# these; production sets them on Northflank's `backup` job only. Locally they
# point at MinIO (testing guide, Test 43). `pnpm backup:check` reads the four
# storage settings, with the read-only restore token in production.
# BACKUP_STORAGE_ENDPOINT=http://127.0.0.1:9100
# BACKUP_STORAGE_BUCKET=pilates-backups
# BACKUP_STORAGE_ACCESS_KEY_ID=
# BACKUP_STORAGE_SECRET_ACCESS_KEY=
# BACKUP_HEARTBEAT_URL=
# BACKUP_PG_DUMP_PATH=/opt/homebrew/opt/postgresql@18/bin/pg_dump
