DATABASE_URL=postgresql://localhost:5432/emma_pilates
NODE_ENV=development
PORT=3100
# Exact admin-web origins allowed to send state-changing cookie requests
# (comma-separated, no wildcards; production requires explicit https origins).
ADMIN_WEB_TRUSTED_ORIGINS=http://localhost:5173
AUTHENTICATION_EMAIL_DIGEST_KEY=replace-with-at-least-32-random-characters
AUTHENTICATION_LINK_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AUTHENTICATION_LINK_ENCRYPTION_KEY_ID=local-development-v1
UPLOADS_LOCAL_STORAGE_ROOT=.data/uploads

# Fixed studio transfer instructions (PAY-002); production must set every value
TRANSFER_BENEFICIARY_NAME="Emma Pilates Studio"
TRANSFER_BANK_NAME="Banco de desarrollo local"
TRANSFER_ACCOUNT_NUMBER=0000000000
TRANSFER_QR_IMAGE_PATH=.data/transfer-qr.png
# Referral reward in BOB centavos; only 6000 (Bs 60) is approved
REFERRAL_REWARD_CENTAVOS=6000
