  "info": {
    "title": "Emma Pilates API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "type": "http"
      }
    },
    "schemas": {
      "LivenessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ClientAuthenticationIdentityDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "client"
            ]
          },
          "clientId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "kind",
          "clientId"
        ]
      },
      "StaffAuthenticationIdentityDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "staff"
            ]
          },
          "staffMemberId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "trainer",
              "nutritionist",
              "assistant",
              "administrator"
            ]
          },
          "branchIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "kind",
          "staffMemberId",
          "role",
          "branchIds"
        ]
      },
      "CreateAuthenticationSessionDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthenticationSessionCredentialDto": {
        "type": "object",
        "properties": {
          "credential": {
            "type": "string",
            "description": "Opaque bearer credential returned only once"
          }
        },
        "required": [
          "credential"
        ]
      },
      "CurrentAuthenticationPrincipalDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "identity": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ClientAuthenticationIdentityDto"
              },
              {
                "$ref": "#/components/schemas/StaffAuthenticationIdentityDto"
              }
            ],
            "discriminator": {
              "propertyName": "kind"
            }
          }
        },
        "required": [
          "accountId",
          "identity"
        ]
      },
      "VerifyClientEmailDto": {
        "type": "object",
        "properties": {
          "verificationToken": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "verificationToken"
        ]
      },
      "ClientEmailVerificationResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "expired",
              "invalid"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "PendingRegistrationContinuationDto": {
        "type": "object",
        "properties": {
          "registrationContinuation": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "registrationContinuation"
        ]
      },
      "PendingVerificationResendDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verification_required"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CorrectPendingClientEmailDto": {
        "type": "object",
        "properties": {
          "registrationContinuation": {
            "type": "string",
            "writeOnly": true
          },
          "email": {
            "type": "string",
            "example": "corrected@example.com",
            "format": "email"
          }
        },
        "required": [
          "registrationContinuation",
          "email"
        ]
      },
      "PendingEmailCorrectionDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verification_required"
            ]
          },
          "email": {
            "type": "string",
            "example": "corrected@example.com",
            "format": "email"
          }
        },
        "required": [
          "status",
          "email"
        ]
      },
      "StartClientRegistrationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ana Clienta"
          },
          "email": {
            "type": "string",
            "example": "ana@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "PendingClientRegistrationDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verification_required"
            ]
          },
          "email": {
            "type": "string",
            "example": "ana@example.com",
            "format": "email"
          },
          "registrationContinuation": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "status",
          "email",
          "registrationContinuation"
        ]
      }
    }
  }
}
