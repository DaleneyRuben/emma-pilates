  "info": {
    "title": "Emma Pilates API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "type": "http"
      }
    },
    "schemas": {
      "LivenessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "AuthenticationLinkTokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token"
        ]
      },
      "AuthenticationLinkInspectionDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "current",
              "expired",
              "invalid"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "activation",
              "password_recovery"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CompleteAccountActivationDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "writeOnly": true
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "AccountActivationResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "activated",
              "expired",
              "invalid"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "RequestPasswordRecoveryDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordRecoveryRequestResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CompletePasswordRecoveryDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "writeOnly": true
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "PasswordRecoveryResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "recovered",
              "expired",
              "invalid"
            ]
          },
          "credential": {
            "type": "string",
            "description": "Opaque bearer credential returned once"
          }
        },
        "required": [
          "status"
        ]
      },
      "ChangeCurrentPasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "writeOnly": true
          },
          "newPassword": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "writeOnly": true
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "ClientAuthenticationIdentityDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "client"
            ]
          },
          "clientId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "kind",
          "clientId"
        ]
      },
      "StaffAuthenticationIdentityDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "staff"
            ]
          },
          "staffMemberId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "trainer",
              "nutritionist",
              "assistant",
              "administrator"
            ]
          },
          "branchIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "kind",
          "staffMemberId",
          "role",
          "branchIds"
        ]
      },
      "CreateAuthenticationSessionDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthenticationSessionCredentialDto": {
        "type": "object",
        "properties": {
          "credential": {
            "type": "string",
            "description": "Opaque bearer credential returned only once"
          }
        },
        "required": [
          "credential"
        ]
      },
      "CurrentAuthenticationPrincipalDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "identity": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ClientAuthenticationIdentityDto"
              },
              {
                "$ref": "#/components/schemas/StaffAuthenticationIdentityDto"
              }
            ],
            "discriminator": {
              "propertyName": "kind"
            }
          }
        },
        "required": [
          "accountId",
          "identity"
        ]
      },
      "VerifyClientEmailDto": {
        "type": "object",
        "properties": {
          "verificationToken": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "verificationToken"
        ]
      },
      "ClientEmailVerificationResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "expired",
              "invalid"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "PendingRegistrationContinuationDto": {
        "type": "object",
        "properties": {
          "registrationContinuation": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "registrationContinuation"
        ]
      },
      "PendingVerificationResendDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verification_required"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CorrectPendingClientEmailDto": {
        "type": "object",
        "properties": {
          "registrationContinuation": {
            "type": "string",
            "writeOnly": true
          },
          "email": {
            "type": "string",
            "example": "corrected@example.com",
            "format": "email"
          }
        },
        "required": [
          "registrationContinuation",
          "email"
        ]
      },
      "PendingEmailCorrectionDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verification_required"
            ]
          },
          "email": {
            "type": "string",
            "example": "corrected@example.com",
            "format": "email"
          }
        },
        "required": [
          "status",
          "email"
        ]
      },
      "StartClientRegistrationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ana Clienta"
          },
          "email": {
            "type": "string",
            "example": "ana@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "PendingClientRegistrationDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verification_required"
            ]
          },
          "email": {
            "type": "string",
            "example": "ana@example.com",
            "format": "email"
          },
          "registrationContinuation": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "status",
          "email",
          "registrationContinuation"
        ]
      },
      "SessionAvailabilityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "branchId": {
            "type": "string",
            "format": "uuid"
          },
          "classTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "trainerStaffMemberId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "format": "date-time",
            "type": "string"
          },
          "endsAt": {
            "format": "date-time",
            "type": "string"
          },
          "capacity": {
            "type": "number",
            "minimum": 1
          },
          "bookedCount": {
            "type": "number",
            "minimum": 0
          },
          "availableSeats": {
            "type": "number",
            "minimum": 0
          },
          "waitlistCount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "branchId",
          "classTypeId",
          "trainerStaffMemberId",
          "startsAt",
          "endsAt",
          "capacity",
          "bookedCount",
          "availableSeats",
          "waitlistCount"
        ]
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreatedBookingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      }
    }
  }
}
