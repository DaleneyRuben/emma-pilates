  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LivenessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "VerifyClientEmailDto": {
        "type": "object",
        "properties": {
          "verificationToken": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "verificationToken"
        ]
      },
      "ClientEmailVerificationResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "expired",
              "invalid"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "PendingRegistrationContinuationDto": {
        "type": "object",
        "properties": {
          "registrationContinuation": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "registrationContinuation"
        ]
      },
      "PendingVerificationResendDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verification_required"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CorrectPendingClientEmailDto": {
        "type": "object",
        "properties": {
          "registrationContinuation": {
            "type": "string",
            "writeOnly": true
          },
          "email": {
            "type": "string",
            "example": "corrected@example.com",
            "format": "email"
          }
        },
        "required": [
          "registrationContinuation",
          "email"
        ]
      },
      "PendingEmailCorrectionDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verification_required"
            ]
          },
          "email": {
            "type": "string",
            "example": "corrected@example.com",
            "format": "email"
          }
        },
        "required": [
          "status",
          "email"
        ]
      },
      "StartClientRegistrationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ana Clienta"
          },
          "email": {
            "type": "string",
            "example": "ana@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "PendingClientRegistrationDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verification_required"
            ]
          },
          "email": {
            "type": "string",
            "example": "ana@example.com",
            "format": "email"
          },
          "registrationContinuation": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "status",
          "email",
          "registrationContinuation"
        ]
      }
    }
  }
