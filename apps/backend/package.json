{
  "name": "@pilates/backend",
  "version": "0.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "admin:bootstrap": "nest build && node dist/src/administrator-bootstrap-main.js",
    "backup:check": "nest build && node dist/src/backup-check-main.js",
    "backup:run": "nest build && node dist/src/database-backup-main.js",
    "build": "nest build",
    "db:fixtures": "nest build && node dist/src/development-fixtures-main.js",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "release": "nest build && node dist/src/backend-release-main.js",
    "promotion": "nest build && node dist/src/production-promotion-main.js",
    "script:dispatch": "nest build && node dist/src/script-dispatch-main.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "start:worker": "nest build && node dist/src/worker-main.js",
    "smoke": "nest build && node dist/src/smoke-check-main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "openapi:generate": "nest build && node dist/src/openapi/generate-openapi.js",
    "test": "TZ=America/La_Paz jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "TZ=America/La_Paz NODE_OPTIONS=\"--experimental-vm-modules ${NODE_OPTIONS:-}\" jest --config ./test/jest-e2e.json",
    "test:integration": "TZ=America/La_Paz NODE_OPTIONS=\"--experimental-vm-modules ${NODE_OPTIONS:-}\" jest --config ./test/jest-integration.json --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1142.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "11.0.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "nestjs-pino": "^5.2.0",
    "pg": "^8.23.0",
    "pg-boss": "12.28.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "29.7.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
