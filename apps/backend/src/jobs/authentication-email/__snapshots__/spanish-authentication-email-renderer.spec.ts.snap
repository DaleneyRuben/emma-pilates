exports[`SpanishAuthenticationEmailRenderer renders the activation email with its link as a button and a bare URL 1`] = `
{
  "subject": "Activa tu cuenta en Emma Pilates Studio",
  "text": "Hola,

El estudio creó una cuenta para ti. Abre el enlace para elegir tu contraseña y activar tu cuenta.

https://links.emmapilates.test/client/authentication/activate-account?token=secret-1

Este enlace vence en 7 días. Si vence, pide en el estudio que te envíen uno nuevo.

Activar tu cuenta no inicia sesión: después vuelve a la app e ingresa con tu correo y la contraseña que elijas.

Emma Pilates Studio · Movimiento · Equilibrio · Bienestar",
}
`;

exports[`SpanishAuthenticationEmailRenderer renders the activation email with its link as a button and a bare URL 2`] = `"<!doctype html><html lang="es"><body style="margin:0;padding:0;background:#F2ECE5;font-family:'Work Sans',Helvetica,Arial,sans-serif;"><div style="max-width:560px;margin:0 auto;padding:32px 16px;"><div style="background:#FFFFFF;border:1px solid #E4D8CC;border-radius:12px;padding:32px 24px;"><h1 style="margin:0 0 24px;font-family:Lora,Georgia,serif;font-weight:500;font-size:22px;line-height:1.3;color:#4A4A4A;">Activa tu cuenta en Emma Pilates Studio</h1><p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#4A4A4A;">Hola,</p><p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#4A4A4A;">El estudio creó una cuenta para ti. Abre el enlace para elegir tu contraseña y activar tu cuenta.</p><p style="margin:24px 0;"><a href="https://links.emmapilates.test/client/authentication/activate-account?token=secret-1" style="display:inline-block;background:#B78380;color:#FFFFFF;text-decoration:none;font-weight:500;padding:14px 24px;border-radius:8px;">Activar mi cuenta</a></p><p style="margin:0 0 16px;font-size:13px;line-height:1.5;color:#6E6663;">Si el botón no funciona, copia este enlace en tu navegador:<br><a href="https://links.emmapilates.test/client/authentication/activate-account?token=secret-1" style="color:#B78380;word-break:break-all;">https://links.emmapilates.test/client/authentication/activate-account?token=secret-1</a></p><p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#4A4A4A;">Este enlace vence en 7 días. Si vence, pide en el estudio que te envíen uno nuevo.</p><p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#4A4A4A;">Activar tu cuenta no inicia sesión: después vuelve a la app e ingresa con tu correo y la contraseña que elijas.</p></div><p style="margin:24px 0 0;text-align:center;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#8A807C;">Emma Pilates Studio<br>Movimiento · Equilibrio · Bienestar</p></div></body></html>"`;

exports[`SpanishAuthenticationEmailRenderer renders the email_change email with its link as a button and a bare URL 1`] = `
{
  "subject": "Confirma tu correo nuevo",
  "text": "Hola,

Pediste usar este correo para entrar a Emma Pilates Studio. Abre el enlace para confirmar el cambio.

https://links.emmapilates.test/client/authentication/confirm-email-change?token=secret-1

Este enlace vence en 24 horas. Hasta que lo confirmes, tu correo anterior sigue siendo el de tu cuenta.

Si no pediste este cambio, ignora este correo.

Emma Pilates Studio · Movimiento · Equilibrio · Bienestar",
}
`;

