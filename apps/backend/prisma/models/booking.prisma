enum StaffRole {
  TRAINER       @map("trainer")
  NUTRITIONIST  @map("nutritionist")
  ASSISTANT     @map("assistant")
  ADMINISTRATOR @map("administrator")
  COORDINATOR   @map("coordinator")

  @@schema("booking")
}

model Client {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String
  phone               String?
  profileImageAssetId String?         @unique @map("profile_image_asset_id") @db.Uuid
  referralCode        String          @unique @map("referral_code")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz(3)
  account             Account?
  subscriptions       Subscription[]
  bookings            Booking[]
  waitlistEntries     WaitlistEntry[]
  profileImageAsset   ImageAsset?     @relation("ClientProfileImage", fields: [profileImageAssetId], references: [id], onDelete: Restrict)
  purchaseIntents     PurchaseIntent[]
  payments            Payment[]
  creditReservations  CreditReservation[]
  creditLedgerEntries CreditLedgerEntry[]
  referralsMade       Referral[]      @relation("ReferralReferrer")
  referralReceived    Referral?       @relation("ReferralReferred")
  evaluations         Evaluation[]
  promotionsConsents  ClientPromotionsConsent[]

  @@map("clients")
  @@schema("booking")
}

model StaffMember {
  id                  String                  @id @default(uuid()) @db.Uuid
  name                String
  phone               String?
  role                StaffRole
  profileImageAssetId String?                 @unique @map("profile_image_asset_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?               @map("deleted_at") @db.Timestamptz(3)
  account             Account?
  profileImageAsset   ImageAsset?             @relation("StaffProfileImage", fields: [profileImageAssetId], references: [id], onDelete: Restrict)
  branchAssignments   StaffBranchAssignment[]
  schedules           SessionSchedule[]
  sessions            Session[]
  availabilityBlocks  AvailabilityBlock[]
  evaluationSlots     EvaluationSlot[]
  salaryPayments      SalaryPayment[]
  impersonations      ImpersonationSession[]

  @@map("staff_members")
  @@schema("booking")
}

model Branch {
  id               String                  @id @default(uuid()) @db.Uuid
  name             String
  address          String
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime?               @map("archived_at") @db.Timestamptz(3)
  staffAssignments StaffBranchAssignment[]
  auditRecords     AuditRecord[]
  schedules        SessionSchedule[]
  sessions         Session[]
  cashPayments     Payment[]
  availabilityBlocks AvailabilityBlock[]
  evaluationSlots  EvaluationSlot[]
  supplies         Supply[]
  expenses         Expense[]
  cashCloses       CashClose[]

  @@map("branches")
  @@schema("booking")
}

model StaffBranchAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  staffMemberId String      @map("staff_member_id") @db.Uuid
  branchId      String      @map("branch_id") @db.Uuid
  assignedAt    DateTime    @default(now()) @map("assigned_at") @db.Timestamptz(3)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(3)
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // (staffMemberId, branchId) is unique among live rows only: a partial index
  // in the BE-011 migration.
  @@map("staff_branch_assignments")
  @@schema("booking")
}

// A former Client who agreed, while closing their own Account, to keep
// receiving promotions (ADR-0097). Deliberately unlinked from the closed
// Client and Account so their history stays anonymous.
model PromotionContact {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  email       String
  phone       String?
  consentedAt DateTime  @map("consented_at") @db.Timestamptz(3)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([email])
  @@map("promotion_contacts")
  @@schema("booking")
}

// A live Client's agreement to promotions, one row per period (ADR-0098).
// At most one open row per Client: a partial unique index in the BE-023
// migration.
model ClientPromotionsConsent {
  id          String    @id @default(uuid()) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  consentedAt DateTime  @map("consented_at") @db.Timestamptz(3)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@map("client_promotions_consents")
  @@schema("booking")
}
