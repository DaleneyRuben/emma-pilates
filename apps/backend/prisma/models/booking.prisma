enum FounderMembershipStatus {
  ACTIVE @map("active")
  LOST   @map("lost")

  @@schema("booking")
}

enum FreezeState {
  REQUESTED @map("requested")
  APPROVED  @map("approved")
  REFUSED   @map("refused")

  @@schema("booking")
}

enum StaffRole {
  TRAINER       @map("trainer")
  NUTRITIONIST  @map("nutritionist")
  ASSISTANT     @map("assistant")
  ADMINISTRATOR @map("administrator")

  @@schema("booking")
}

model Client {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String
  phone               String?
  profileImageAssetId String?         @unique @map("profile_image_asset_id") @db.Uuid
  referralCode        String          @unique @map("referral_code")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz(3)
  account             Account?
  subscriptions       Subscription[]
  bookings            Booking[]
  waitlistEntries     WaitlistEntry[]
  profileImageAsset   ImageAsset?     @relation("ClientProfileImage", fields: [profileImageAssetId], references: [id], onDelete: Restrict)
  purchaseIntents     PurchaseIntent[]
  payments            Payment[]
  creditReservations  CreditReservation[]
  creditLedgerEntries CreditLedgerEntry[]
  referralsMade       Referral[]      @relation("ReferralReferrer")
  referralReceived    Referral?       @relation("ReferralReferred")
  evaluations         Evaluation[]
  promotionsConsents  ClientPromotionsConsent[]
  founderMembership   FounderMembership?
  freezes             Freeze[]

  @@map("clients")
  @@schema("booking")
}

// BKM-010 / booking ADR-0008: one membership per Client, numbered 1–40 in
// confirmation order. A lost membership stays; the number is never reused.
model FounderMembership {
  id         String                  @id @default(uuid()) @db.Uuid
  clientId   String                  @unique @map("client_id") @db.Uuid
  number     Int                     @unique @db.SmallInt
  since      DateTime                @db.Timestamptz(3)
  status     FounderMembershipStatus @default(ACTIVE)
  reason     String?
  lostAt     DateTime?               @map("lost_at") @db.Timestamptz(3)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime?               @map("deleted_at") @db.Timestamptz(3)
  client     Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([status, number])
  @@map("founder_memberships")
  @@schema("booking")
}

// BKM-012 / booking ADR-0010: one request per Subscription. A refused request
// still counts, so the unique live row is the once-per-Plan rule.
model Freeze {
  id                 String      @id @default(uuid()) @db.Uuid
  subscriptionId     String      @unique @map("subscription_id") @db.Uuid
  clientId           String      @map("client_id") @db.Uuid
  startsOn           DateTime    @map("starts_on") @db.Date
  endsOn             DateTime    @map("ends_on") @db.Date
  reason             String
  state              FreezeState @default(REQUESTED)
  decidedByAccountId String?     @map("decided_by_account_id") @db.Uuid
  decidedAt          DateTime?   @map("decided_at") @db.Timestamptz(3)
  auditRecordId      String?     @map("audit_record_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(3)
  subscription       Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  client             Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  decidedByAccount   Account?     @relation("FreezeDecidedBy", fields: [decidedByAccountId], references: [id], onDelete: Restrict)

  @@index([clientId, state])
  @@index([decidedByAccountId])
  @@map("freezes")
  @@schema("booking")
}

model StaffMember {
  id                  String                  @id @default(uuid()) @db.Uuid
  name                String
  phone               String?
  role                StaffRole
  profileImageAssetId String?                 @unique @map("profile_image_asset_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?               @map("deleted_at") @db.Timestamptz(3)
  account             Account?
  profileImageAsset   ImageAsset?             @relation("StaffProfileImage", fields: [profileImageAssetId], references: [id], onDelete: Restrict)
  branchAssignments   StaffBranchAssignment[]
  schedules           SessionSchedule[]
  sessions            Session[]
  availabilityBlocks  AvailabilityBlock[]
  evaluationSlots     EvaluationSlot[]
  salaryPayments      SalaryPayment[]
  impersonations      ImpersonationSession[]

  @@map("staff_members")
  @@schema("booking")
}

model Branch {
  id               String                  @id @default(uuid()) @db.Uuid
  name             String
  address          String
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime?               @map("archived_at") @db.Timestamptz(3)
  staffAssignments StaffBranchAssignment[]
  auditRecords     AuditRecord[]
  schedules        SessionSchedule[]
  sessions         Session[]
  cashPayments     Payment[]
  availabilityBlocks AvailabilityBlock[]
  evaluationSlots  EvaluationSlot[]
  supplies         Supply[]
  expenses         Expense[]

  @@map("branches")
  @@schema("booking")
}

model StaffBranchAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  staffMemberId String      @map("staff_member_id") @db.Uuid
  branchId      String      @map("branch_id") @db.Uuid
  assignedAt    DateTime    @default(now()) @map("assigned_at") @db.Timestamptz(3)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(3)
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // (staffMemberId, branchId) is unique among live rows only: a partial index
  // in the BE-011 migration.
  @@map("staff_branch_assignments")
  @@schema("booking")
}

// A former Client who agreed, while closing their own Account, to keep
// receiving promotions (ADR-0097). Deliberately unlinked from the closed
// Client and Account so their history stays anonymous.
model PromotionContact {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  email       String
  phone       String?
  consentedAt DateTime  @map("consented_at") @db.Timestamptz(3)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([email])
  @@map("promotion_contacts")
  @@schema("booking")
}

// A live Client's agreement to promotions, one row per period (ADR-0098).
// At most one open row per Client: a partial unique index in the BE-023
// migration.
model ClientPromotionsConsent {
  id          String    @id @default(uuid()) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  consentedAt DateTime  @map("consented_at") @db.Timestamptz(3)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@map("client_promotions_consents")
  @@schema("booking")
}
