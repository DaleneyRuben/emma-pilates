enum SessionState {
  SCHEDULED @map("scheduled")
  CANCELLED @map("cancelled")

  @@schema("booking")
}

enum SessionCancellationCause {
  ZERO_BOOKINGS         @map("zero_bookings")
  NO_SUBSTITUTE_TRAINER @map("no_substitute_trainer")
  SCHEDULE_CHANGED      @map("schedule_changed")
  MINIMUM_NOT_MET       @map("minimum_not_met")

  @@schema("booking")
}

enum SubscriptionState {
  ACTIVE  @map("active")
  EXPIRED @map("expired")

  @@schema("booking")
}

enum AllowanceAdjustmentReason {
  GIFT_NEW_CLIENT  @map("gift_new_client")
  INVITE_CONVERTED @map("invite_converted")
  CAMPAIGN         @map("campaign")
  COURTESY         @map("courtesy")
  CLASS_RETURN     @map("class_return")
  CONSUMPTION      @map("consumption")

  @@schema("booking")
}

model Plan {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  // Deprecated (booking ADR-0005): nothing writes it; the contract derives
  // durationMonths from durationDays for old builds.
  durationMonths Int?           @map("duration_months") @db.SmallInt
  durationDays   Int            @map("duration_days") @db.SmallInt
  weeklyClassCap Int?           @map("weekly_class_cap") @db.SmallInt
  classAllowance Int            @map("class_allowance")
  priceCentavos  Int            @map("price_centavos")
  displayOrder   Int            @map("display_order")
  hiddenAt       DateTime?      @map("hidden_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions  Subscription[]
  purchaseIntents PurchaseIntent[]
  payments       Payment[]

  @@index([hiddenAt, displayOrder, id])
  @@map("plans")
  @@schema("booking")
}

model ClassType {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  description     String
  // Deprecated (booking ADR-0004): nothing writes it; dropped after old apps.
  durationMinutes Int?              @map("duration_minutes") @db.SmallInt
  defaultCapacity Int               @map("default_capacity") @db.SmallInt
  equipmentNeeds  String?           @map("equipment_needs")
  archivedAt      DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  schedules       SessionSchedule[]
  sessions        Session[]

  @@map("class_types")
  @@schema("booking")
}

model SessionSchedule {
  id                   String      @id @default(uuid()) @db.Uuid
  branchId             String      @map("branch_id") @db.Uuid
  classTypeId          String      @map("class_type_id") @db.Uuid
  trainerStaffMemberId String      @map("trainer_staff_member_id") @db.Uuid
  weekday              Int         @db.SmallInt
  startsAtLocal        DateTime    @map("starts_at_local") @db.Time(0)
  durationMinutes      Int         @map("duration_minutes") @db.SmallInt
  capacity             Int         @db.SmallInt
  effectiveFrom        DateTime    @map("effective_from") @db.Date
  effectiveUntil       DateTime?   @map("effective_until") @db.Date
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch               Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classType            ClassType   @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  trainer              StaffMember @relation(fields: [trainerStaffMemberId], references: [id], onDelete: Restrict)
  sessions             Session[]

  @@index([branchId, effectiveFrom])
  @@index([classTypeId])
  @@index([trainerStaffMemberId])
  @@map("session_schedules")
  @@schema("booking")
}

model Session {
  id                           String                    @id @default(uuid()) @db.Uuid
  sessionScheduleId            String?                   @map("session_schedule_id") @db.Uuid
  branchId                     String                    @map("branch_id") @db.Uuid
  classTypeId                  String                    @map("class_type_id") @db.Uuid
  trainerStaffMemberId         String                    @map("trainer_staff_member_id") @db.Uuid
  startsAt                     DateTime                  @map("starts_at") @db.Timestamptz(3)
  // The schedule occurrence a generated Session stands for; never moves (ADM-001).
  occurrenceStartsAt           DateTime?                 @map("occurrence_starts_at") @db.Timestamptz(3)
  endsAt                       DateTime                  @map("ends_at") @db.Timestamptz(3)
  capacity                     Int                       @db.SmallInt
  state                        SessionState              @default(SCHEDULED)
  isException                  Boolean                   @default(false) @map("is_exception")
  cancellationCause            SessionCancellationCause? @map("cancellation_cause")
  cancelledAt                  DateTime?                 @map("cancelled_at") @db.Timestamptz(3)
  cancelledByAccountId         String?                   @map("cancelled_by_account_id") @db.Uuid
  cancellationNote             String?                   @map("cancellation_note")
  // The one-time Minimum Bookings check (ADR-0007, BKM-009); the column kept
  // BOOK-004's name when the zero-booking check became this check.
  minimumBookingsCheckCompletedAt DateTime?              @map("empty_booking_check_completed_at") @db.Timestamptz(3)
  // Live Bookings when the Cancellation Window closed; Trainer pay counts them.
  bookingsAtWindowClose        Int?                      @map("bookings_at_window_close") @db.SmallInt
  createdAt                    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessionSchedule              SessionSchedule?          @relation(fields: [sessionScheduleId], references: [id], onDelete: Restrict)
  branch                       Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classType                    ClassType                 @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  trainer                      StaffMember               @relation(fields: [trainerStaffMemberId], references: [id], onDelete: Restrict)
  cancelledByAccount           Account?                  @relation(fields: [cancelledByAccountId], references: [id], onDelete: Restrict)
  bookings                     Booking[]
  waitlistEntries              WaitlistEntry[]

  @@unique([sessionScheduleId, occurrenceStartsAt])
  @@index([branchId, startsAt, id])
  @@index([trainerStaffMemberId, startsAt])
  @@index([classTypeId])
  @@index([cancelledByAccountId])
  @@map("sessions")
  @@schema("booking")
}

model Subscription {
  id                      String            @id @default(uuid()) @db.Uuid
  clientId                String            @map("client_id") @db.Uuid
  planId                  String            @map("plan_id") @db.Uuid
  planNameSnapshot        String            @map("plan_name_snapshot")
  // Deprecated (booking ADR-0005): nothing writes it.
  durationMonthsSnapshot  Int?              @map("duration_months_snapshot") @db.SmallInt
  durationDaysSnapshot    Int               @map("duration_days_snapshot") @db.SmallInt
  weeklyClassCapSnapshot  Int?              @map("weekly_class_cap_snapshot") @db.SmallInt
  originalClassAllowance  Int               @map("original_class_allowance")
  remainingClassAllowance Int               @map("remaining_class_allowance")
  startsOn                DateTime          @map("starts_on") @db.Date
  endsOn                  DateTime          @map("ends_on") @db.Date
  state                   SubscriptionState @default(ACTIVE)
  activatedAt             DateTime          @map("activated_at") @db.Timestamptz(3)
  expiredAt               DateTime?         @map("expired_at") @db.Timestamptz(3)
  paymentId               String?           @unique @map("payment_id") @db.Uuid
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  client                  Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  plan                    Plan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment                 Payment?          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bookings                Booking[]
  evaluations             Evaluation[]
  allowanceAdjustments    AllowanceAdjustment[]
  freezes                 Freeze[]

  @@unique([id, clientId])
  @@index([clientId, startsOn])
  @@index([planId])
  @@index([state, endsOn])
  @@map("subscriptions")
  @@schema("booking")
}

// BKM-008, booking ADR-0006: extra classes live here, never on the Payment
// or the Plan's allowance, so a report can tell bought classes from given
// ones. A removal is deleted_at (ADR-0086). One live gift per Client is a
// partial unique index in the migration.
model AllowanceAdjustment {
  id                String                    @id @default(uuid()) @db.Uuid
  subscriptionId    String                    @map("subscription_id") @db.Uuid
  // Denormalized so one live gift per Client is a partial unique index.
  // PostgreSQL cannot index a subquery over the Subscription.
  clientId          String                    @map("client_id") @db.Uuid
  classes           Int                       @db.SmallInt
  reason            AllowanceAdjustmentReason
  authorAccountId   String                    @map("author_account_id") @db.Uuid
  // Set only when an extra class funds a Booking, so the weekly cap can
  // tell that Booking from one funded by the base allowance (BKM-007).
  bookingId         String?                   @unique @map("booking_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt         DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  subscription      Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  client            Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  authorAccount     Account                   @relation("AllowanceAdjustmentAuthor", fields: [authorAccountId], references: [id], onDelete: Restrict)
  booking           Booking?                  @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, createdAt])
  @@index([authorAccountId])
  @@map("allowance_adjustments")
  @@schema("booking")
}

model Promotion {
  id              String      @id @default(uuid()) @db.Uuid
  headline        String
  description     String
  imageAssetId    String?     @map("image_asset_id") @db.Uuid
  displayStartsOn DateTime    @map("display_starts_on") @db.Date
  displayEndsOn   DateTime    @map("display_ends_on") @db.Date
  displayOrder    Int         @map("display_order")
  publishedAt     DateTime?   @map("published_at") @db.Timestamptz(3)
  archivedAt      DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  imageAsset      ImageAsset? @relation(fields: [imageAssetId], references: [id], onDelete: Restrict)

  @@index([imageAssetId])
  @@index([displayOrder, id])
  @@map("promotions")
  @@schema("booking")
}
