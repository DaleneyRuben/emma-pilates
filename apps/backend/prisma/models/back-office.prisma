model Supply {
  id                 String          @id @default(uuid()) @db.Uuid
  branchId           String          @map("branch_id") @db.Uuid
  name               String
  initialQuantity    Int             @map("initial_quantity")
  quantityOnHand     Int             @map("quantity_on_hand")
  lowStockThreshold  Int             @map("low_stock_threshold")
  createdByAccountId String          @map("created_by_account_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt         DateTime?       @map("archived_at") @db.Timestamptz(3)
  branch             Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdByAccount   Account         @relation("SupplyCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  withdrawals        Withdrawal[]
  restocks           SupplyRestock[]

  @@index([branchId])
  @@index([createdByAccountId])
  @@map("supplies")
  @@schema("back_office")
}

model Withdrawal {
  id                  String   @id @default(uuid()) @db.Uuid
  supplyId            String   @map("supply_id") @db.Uuid
  quantity            Int
  recordedByAccountId String   @map("recorded_by_account_id") @db.Uuid
  recordedAt          DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  supply              Supply   @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  recordedByAccount   Account  @relation("WithdrawalRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: Restrict)

  @@index([supplyId, recordedAt])
  @@index([recordedAt])
  @@index([recordedByAccountId])
  @@map("withdrawals")
  @@schema("back_office")
}

model SupplyRestock {
  id                  String   @id @default(uuid()) @db.Uuid
  supplyId            String   @map("supply_id") @db.Uuid
  quantity            Int
  recordedByAccountId String   @map("recorded_by_account_id") @db.Uuid
  recordedAt          DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  supply              Supply   @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  recordedByAccount   Account  @relation("SupplyRestockRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: Restrict)

  @@index([supplyId, recordedAt])
  @@index([recordedByAccountId])
  @@map("supply_restocks")
  @@schema("back_office")
}

// BKO-006: the dated rates a Trainer statement is calculated with. A change
// is a new row; the statement reads the row in force at the month start.
model PayRateRule {
  id                     String   @id @default(uuid()) @db.Uuid
  classCentavos          Int      @map("class_centavos")
  includedStudents       Int      @map("included_students") @db.SmallInt
  extraStudentCentavos   Int      @map("extra_student_centavos")
  minimumNotMetCentavos  Int      @map("minimum_not_met_centavos")
  commissionPercent      Int      @map("commission_percent") @db.SmallInt
  effectiveFrom          DateTime @map("effective_from") @db.Date
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([effectiveFrom])
  @@map("pay_rate_rules")
  @@schema("back_office")
}

enum PayStatementState {
  DRAFT    @map("draft")
  APPROVED @map("approved")

  @@schema("back_office")
}

enum PayStatementLineKind {
  CLASS            @map("class")
  MINIMUM_NOT_MET  @map("minimum_not_met")
  COMMISSION       @map("commission")
  BASE             @map("base")
  NEW_CLIENT       @map("new_client")
  BONUS            @map("bonus")

  @@schema("back_office")
}

// A Staff Member's statement for a period [periodStart, periodEnd): a day, a
// week, a range or a month for a Trainer, a month for the Coordinator
// (ADR-0109). `month` is the first day of the period's month, kept for the
// released Staff app. Two live statements of one Staff Member never overlap:
// a raw EXCLUDE constraint in 20261104090000_pay_statement_periods. A draft is
// replaced; approval freezes it and creates the Salary Payment. A removed
// statement keeps its rows.
model PayStatement {
  id                  String            @id @default(uuid()) @db.Uuid
  staffMemberId       String            @map("staff_member_id") @db.Uuid
  month               DateTime          @db.Date
  periodStart         DateTime          @map("period_start") @db.Date
  periodEnd           DateTime          @map("period_end") @db.Date
  state               PayStatementState @default(DRAFT)
  totalCentavos       Int               @map("total_centavos")
  salaryPaymentId     String?           @unique @map("salary_payment_id") @db.Uuid
  approvedByAccountId String?           @map("approved_by_account_id") @db.Uuid
  approvedAt          DateTime?         @map("approved_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?         @map("deleted_at") @db.Timestamptz(3)
  staffMember         StaffMember       @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  salaryPayment       SalaryPayment?    @relation(fields: [salaryPaymentId], references: [id], onDelete: Restrict)
  approvedByAccount   Account?          @relation("PayStatementApprovedBy", fields: [approvedByAccountId], references: [id], onDelete: Restrict)
  lines               PayStatementLine[]

  @@index([staffMemberId, month])
  @@index([month, state])
  @@index([periodStart, periodEnd])
  @@index([approvedByAccountId])
  @@map("pay_statements")
  @@schema("back_office")
}

model PayStatementLine {
  id               String               @id @default(uuid()) @db.Uuid
  payStatementId   String               @map("pay_statement_id") @db.Uuid
  kind             PayStatementLineKind
  detail           String
  amountCentavos   Int                  @map("amount_centavos")
  position         Int                  @db.SmallInt
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(3)
  payStatement     PayStatement         @relation(fields: [payStatementId], references: [id], onDelete: Restrict)

  @@index([payStatementId, position])
  @@map("pay_statement_lines")
  @@schema("back_office")
}

model SalaryPayment {
  id                  String      @id @default(uuid()) @db.Uuid
  staffMemberId       String      @map("staff_member_id") @db.Uuid
  amountCentavos      Int         @map("amount_centavos")
  paidOn              DateTime    @map("paid_on") @db.Date
  recordedByAccountId String      @map("recorded_by_account_id") @db.Uuid
  // BKO-008: the photo of the transfer, kept by the uploads context.
  receiptImageAssetId String?     @unique @map("receipt_image_asset_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  staffMember         StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  recordedByAccount   Account     @relation("SalaryPaymentRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: Restrict)
  receiptImageAsset   ImageAsset? @relation("SalaryPaymentReceipt", fields: [receiptImageAssetId], references: [id], onDelete: Restrict)
  payStatement        PayStatement?

  @@index([paidOn])
  @@index([staffMemberId, paidOn])
  @@index([recordedByAccountId])
  @@map("salary_payments")
  @@schema("back_office")
}

// FIX-072 (walkthrough finding 106): the bank QR a staff member is paid by and
// its last valid day. One current row per person (a partial unique index in
// the migration); a new QR ends the old one with `replacedAt`, never deletes.
model StaffPayoutQr {
  id                  String      @id @default(uuid()) @db.Uuid
  staffMemberId       String      @map("staff_member_id") @db.Uuid
  imageAssetId        String      @unique @map("image_asset_id") @db.Uuid
  validUntil          DateTime    @map("valid_until") @db.Date
  uploadedByAccountId String      @map("uploaded_by_account_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  replacedAt          DateTime?   @map("replaced_at") @db.Timestamptz(3)
  staffMember         StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  imageAsset          ImageAsset  @relation("StaffPayoutQrImage", fields: [imageAssetId], references: [id], onDelete: Restrict)
  uploadedByAccount   Account     @relation("StaffPayoutQrUploadedBy", fields: [uploadedByAccountId], references: [id], onDelete: Restrict)

  @@index([staffMemberId])
  @@index([uploadedByAccountId])
  @@map("staff_payout_qrs")
  @@schema("back_office")
}

// BKO-005: the fixed-cost budget, one row per line. Contingencies are not a
// row; they are a percent of the subtotal, computed when the month is read.
model CostBudgetLine {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  monthlyCentavos  Int      @map("monthly_centavos")
  position         Int      @db.SmallInt
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("cost_budget_lines")
  @@schema("back_office")
}

model ExpenseCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  expenses  Expense[]

  @@map("expense_categories")
  @@schema("back_office")
}

model Expense {
  id                  String          @id @default(uuid()) @db.Uuid
  branchId            String          @map("branch_id") @db.Uuid
  expenseCategoryId   String          @map("expense_category_id") @db.Uuid
  amountCentavos      Int             @map("amount_centavos")
  incurredOn          DateTime        @map("incurred_on") @db.Date
  recordedByAccountId String          @map("recorded_by_account_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Finding 104: «eliminar» voids the Expense (ADR-0086): who, when, and why.
  voidedAt            DateTime?       @map("voided_at") @db.Timestamptz(3)
  voidedByAccountId   String?         @map("voided_by_account_id") @db.Uuid
  voidReason          String?         @map("void_reason")
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  expenseCategory     ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)
  recordedByAccount   Account         @relation("ExpenseRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: Restrict)
  voidedByAccount     Account?        @relation("ExpenseVoidedBy", fields: [voidedByAccountId], references: [id], onDelete: Restrict)

  @@index([branchId, incurredOn])
  @@index([incurredOn])
  @@index([expenseCategoryId])
  @@index([recordedByAccountId])
  @@index([voidedByAccountId])
  @@map("expenses")
  @@schema("back_office")
}

enum EquipmentKind {
  REFORMER @map("reformer")
  CADILLAC @map("cadillac")
  MAT      @map("mat")

  @@schema("back_office")
}

enum EquipmentTracking {
  UNIT     @map("unit")
  QUANTITY @map("quantity")

  @@schema("back_office")
}

// FIX-067: a studio-wide Equipment Type, tracked as numbered units or as a
// count per Branch. The three seeded types carry the old kind (legacy_kind).
// lower(name) is unique among types not archived: a partial index in the
// migration; tracking never changes and archiving is final (triggers).
model EquipmentType {
  id                 String            @id @default(uuid()) @db.Uuid
  name               String
  tracking           EquipmentTracking
  legacyKind         EquipmentKind?    @unique @map("legacy_kind")
  createdByAccountId String?           @map("created_by_account_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt         DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdByAccount   Account?          @relation("EquipmentTypeCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  equipment          Equipment[]
  stocks             EquipmentStock[]

  @@index([createdByAccountId])
  @@map("equipment_types")
  @@schema("back_office")
}

// BKO-004 (ADR-0106): a numbered machine of a Branch. (branch, type, number)
// is unique among Equipment not archived: a partial index in the migration.
// FIX-067: kind is still written for the three seeded types (old Staff app
// builds read it) and null for a studio type.
model Equipment {
  id                 String           @id @default(uuid()) @db.Uuid
  branchId           String           @map("branch_id") @db.Uuid
  typeId             String           @map("type_id") @db.Uuid
  kind               EquipmentKind?
  number             Int              @db.SmallInt
  createdByAccountId String           @map("created_by_account_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt         DateTime?        @map("archived_at") @db.Timestamptz(3)
  branch             Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type               EquipmentType    @relation(fields: [typeId], references: [id], onDelete: Restrict)
  createdByAccount   Account          @relation("EquipmentCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  issues             EquipmentIssue[]

  @@index([branchId, kind])
  @@index([typeId])
  @@index([createdByAccountId])
  @@map("equipment")
  @@schema("back_office")
}

// FIX-067: how many of a quantity type a Branch has; only the count changes.
model EquipmentStock {
  id        String           @id @default(uuid()) @db.Uuid
  branchId  String           @map("branch_id") @db.Uuid
  typeId    String           @map("type_id") @db.Uuid
  quantity  Int
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch    Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type      EquipmentType    @relation(fields: [typeId], references: [id], onDelete: Restrict)
  issues    EquipmentIssue[]

  @@unique([branchId, typeId])
  @@index([typeId])
  @@map("equipment_stocks")
  @@schema("back_office")
}

// A fault on one piece of Equipment, or damage to some of a Branch's stock of
// a quantity type (FIX-067); resolving it is its only change.
model EquipmentIssue {
  id                  String          @id @default(uuid()) @db.Uuid
  equipmentId         String?         @map("equipment_id") @db.Uuid
  stockId             String?         @map("stock_id") @db.Uuid
  quantity            Int?            @db.SmallInt
  description         String
  outOfService        Boolean         @map("out_of_service")
  writtenOff          Boolean         @default(false) @map("written_off")
  reportedByAccountId String          @map("reported_by_account_id") @db.Uuid
  reportedAt          DateTime        @default(now()) @map("reported_at") @db.Timestamptz(3)
  resolvedByAccountId String?         @map("resolved_by_account_id") @db.Uuid
  resolvedAt          DateTime?       @map("resolved_at") @db.Timestamptz(3)
  equipment           Equipment?      @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  stock               EquipmentStock? @relation(fields: [stockId], references: [id], onDelete: Restrict)
  reportedByAccount   Account         @relation("EquipmentIssueReportedBy", fields: [reportedByAccountId], references: [id], onDelete: Restrict)
  resolvedByAccount   Account?        @relation("EquipmentIssueResolvedBy", fields: [resolvedByAccountId], references: [id], onDelete: Restrict)

  @@index([equipmentId, resolvedAt])
  @@index([stockId, resolvedAt])
  @@index([reportedAt])
  @@index([reportedByAccountId])
  @@index([resolvedByAccountId])
  @@map("equipment_issues")
  @@schema("back_office")
}

// BKO-003: one Cash Close a day per Branch, immutable once made.
model CashClose {
  id                String   @id @default(uuid()) @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  businessDate      DateTime @map("business_date") @db.Date
  expectedCentavos  Int      @map("expected_centavos")
  cashPaymentCount  Int      @map("cash_payment_count")
  countedCentavos   Int      @map("counted_centavos")
  note              String?
  closedByAccountId String   @map("closed_by_account_id") @db.Uuid
  closedAt          DateTime @map("closed_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  closedByAccount   Account  @relation("CashCloseClosedBy", fields: [closedByAccountId], references: [id], onDelete: Restrict)

  @@unique([branchId, businessDate])
  @@index([businessDate])
  @@index([closedByAccountId])
  @@map("cash_closes")
  @@schema("back_office")
}
