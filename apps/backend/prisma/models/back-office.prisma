model Supply {
  id                 String          @id @default(uuid()) @db.Uuid
  branchId           String          @map("branch_id") @db.Uuid
  name               String
  initialQuantity    Int             @map("initial_quantity")
  quantityOnHand     Int             @map("quantity_on_hand")
  lowStockThreshold  Int             @map("low_stock_threshold")
  createdByAccountId String          @map("created_by_account_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt         DateTime?       @map("archived_at") @db.Timestamptz(3)
  branch             Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdByAccount   Account         @relation("SupplyCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  withdrawals        Withdrawal[]
  restocks           SupplyRestock[]

  @@index([branchId])
  @@index([createdByAccountId])
  @@map("supplies")
  @@schema("back_office")
}

model Withdrawal {
  id                  String   @id @default(uuid()) @db.Uuid
  supplyId            String   @map("supply_id") @db.Uuid
  quantity            Int
  recordedByAccountId String   @map("recorded_by_account_id") @db.Uuid
  recordedAt          DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  supply              Supply   @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  recordedByAccount   Account  @relation("WithdrawalRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: Restrict)

  @@index([supplyId, recordedAt])
  @@index([recordedAt])
  @@index([recordedByAccountId])
  @@map("withdrawals")
  @@schema("back_office")
}

model SupplyRestock {
  id                  String   @id @default(uuid()) @db.Uuid
  supplyId            String   @map("supply_id") @db.Uuid
  quantity            Int
  recordedByAccountId String   @map("recorded_by_account_id") @db.Uuid
  recordedAt          DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  supply              Supply   @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  recordedByAccount   Account  @relation("SupplyRestockRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: Restrict)

  @@index([supplyId, recordedAt])
  @@index([recordedByAccountId])
  @@map("supply_restocks")
  @@schema("back_office")
}

model SalaryPayment {
  id                  String      @id @default(uuid()) @db.Uuid
  staffMemberId       String      @map("staff_member_id") @db.Uuid
  amountCentavos      Int         @map("amount_centavos")
  paidOn              DateTime    @map("paid_on") @db.Date
  recordedByAccountId String      @map("recorded_by_account_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  staffMember         StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  recordedByAccount   Account     @relation("SalaryPaymentRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: Restrict)

  @@index([paidOn])
  @@index([staffMemberId, paidOn])
  @@index([recordedByAccountId])
  @@map("salary_payments")
  @@schema("back_office")
}

model ExpenseCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  expenses  Expense[]

  @@map("expense_categories")
  @@schema("back_office")
}

model Expense {
  id                  String          @id @default(uuid()) @db.Uuid
  branchId            String          @map("branch_id") @db.Uuid
  expenseCategoryId   String          @map("expense_category_id") @db.Uuid
  amountCentavos      Int             @map("amount_centavos")
  incurredOn          DateTime        @map("incurred_on") @db.Date
  recordedByAccountId String          @map("recorded_by_account_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  expenseCategory     ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)
  recordedByAccount   Account         @relation("ExpenseRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: Restrict)

  @@index([branchId, incurredOn])
  @@index([incurredOn])
  @@index([expenseCategoryId])
  @@index([recordedByAccountId])
  @@map("expenses")
  @@schema("back_office")
}

enum EquipmentKind {
  REFORMER @map("reformer")
  CADILLAC @map("cadillac")
  MAT      @map("mat")

  @@schema("back_office")
}

// BKO-004 (ADR-0106): a numbered machine of a Branch. (branch, kind, number)
// is unique among Equipment not archived: a partial index in the migration.
model Equipment {
  id                 String           @id @default(uuid()) @db.Uuid
  branchId           String           @map("branch_id") @db.Uuid
  kind               EquipmentKind
  number             Int              @db.SmallInt
  createdByAccountId String           @map("created_by_account_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt         DateTime?        @map("archived_at") @db.Timestamptz(3)
  branch             Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdByAccount   Account          @relation("EquipmentCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  issues             EquipmentIssue[]

  @@index([branchId, kind])
  @@index([createdByAccountId])
  @@map("equipment")
  @@schema("back_office")
}

// A fault on one piece of Equipment; resolving it is its only change.
model EquipmentIssue {
  id                  String    @id @default(uuid()) @db.Uuid
  equipmentId         String    @map("equipment_id") @db.Uuid
  description         String
  outOfService        Boolean   @map("out_of_service")
  reportedByAccountId String    @map("reported_by_account_id") @db.Uuid
  reportedAt          DateTime  @default(now()) @map("reported_at") @db.Timestamptz(3)
  resolvedByAccountId String?   @map("resolved_by_account_id") @db.Uuid
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(3)
  equipment           Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  reportedByAccount   Account   @relation("EquipmentIssueReportedBy", fields: [reportedByAccountId], references: [id], onDelete: Restrict)
  resolvedByAccount   Account?  @relation("EquipmentIssueResolvedBy", fields: [resolvedByAccountId], references: [id], onDelete: Restrict)

  @@index([equipmentId, resolvedAt])
  @@index([reportedAt])
  @@index([reportedByAccountId])
  @@index([resolvedByAccountId])
  @@map("equipment_issues")
  @@schema("back_office")
}
