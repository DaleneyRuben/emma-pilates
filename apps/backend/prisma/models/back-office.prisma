model Supply {
  id                 String          @id @default(uuid()) @db.Uuid
  branchId           String          @map("branch_id") @db.Uuid
  name               String
  initialQuantity    Int             @map("initial_quantity")
  quantityOnHand     Int             @map("quantity_on_hand")
  lowStockThreshold  Int             @map("low_stock_threshold")
  createdByAccountId String          @map("created_by_account_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt         DateTime?       @map("archived_at") @db.Timestamptz(3)
  branch             Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdByAccount   Account         @relation("SupplyCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  withdrawals        Withdrawal[]
  restocks           SupplyRestock[]

  @@index([branchId])
  @@index([createdByAccountId])
  @@map("supplies")
  @@schema("back_office")
}

model Withdrawal {
  id                  String   @id @default(uuid()) @db.Uuid
  supplyId            String   @map("supply_id") @db.Uuid
  quantity            Int
  recordedByAccountId String   @map("recorded_by_account_id") @db.Uuid
  recordedAt          DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  supply              Supply   @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  recordedByAccount   Account  @relation("WithdrawalRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: Restrict)

  @@index([supplyId, recordedAt])
  @@index([recordedAt])
  @@index([recordedByAccountId])
  @@map("withdrawals")
  @@schema("back_office")
}

model SupplyRestock {
  id                  String   @id @default(uuid()) @db.Uuid
  supplyId            String   @map("supply_id") @db.Uuid
  quantity            Int
  recordedByAccountId String   @map("recorded_by_account_id") @db.Uuid
  recordedAt          DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  supply              Supply   @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  recordedByAccount   Account  @relation("SupplyRestockRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: Restrict)

  @@index([supplyId, recordedAt])
  @@index([recordedByAccountId])
  @@map("supply_restocks")
  @@schema("back_office")
}

// BKO-006: the dated rates a Trainer statement is calculated with. A change
// is a new row; the statement reads the row in force at the month start.
model PayRateRule {
  id                     String   @id @default(uuid()) @db.Uuid
  classCentavos          Int      @map("class_centavos")
  includedStudents       Int      @map("included_students") @db.SmallInt
  extraStudentCentavos   Int      @map("extra_student_centavos")
  minimumNotMetCentavos  Int      @map("minimum_not_met_centavos")
  commissionPercent      Int      @map("commission_percent") @db.SmallInt
  effectiveFrom          DateTime @map("effective_from") @db.Date
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([effectiveFrom])
  @@map("pay_rate_rules")
  @@schema("back_office")
}

enum PayStatementState {
  DRAFT    @map("draft")
  APPROVED @map("approved")

  @@schema("back_office")
}

enum PayStatementLineKind {
  CLASS            @map("class")
  MINIMUM_NOT_MET  @map("minimum_not_met")
  COMMISSION       @map("commission")

  @@schema("back_office")
}

// One statement per Trainer per month. A draft is replaced; approval freezes
// it and creates the Salary Payment. A removed statement keeps its rows.
model PayStatement {
  id                  String            @id @default(uuid()) @db.Uuid
  staffMemberId       String            @map("staff_member_id") @db.Uuid
  month               DateTime          @db.Date
  state               PayStatementState @default(DRAFT)
  totalCentavos       Int               @map("total_centavos")
  salaryPaymentId     String?           @unique @map("salary_payment_id") @db.Uuid
  approvedByAccountId String?           @map("approved_by_account_id") @db.Uuid
  approvedAt          DateTime?         @map("approved_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?         @map("deleted_at") @db.Timestamptz(3)
  staffMember         StaffMember       @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  salaryPayment       SalaryPayment?    @relation(fields: [salaryPaymentId], references: [id], onDelete: Restrict)
  approvedByAccount   Account?          @relation("PayStatementApprovedBy", fields: [approvedByAccountId], references: [id], onDelete: Restrict)
  lines               PayStatementLine[]

  @@index([staffMemberId, month])
  @@index([month, state])
  @@index([approvedByAccountId])
  @@map("pay_statements")
  @@schema("back_office")
}

model PayStatementLine {
  id               String               @id @default(uuid()) @db.Uuid
  payStatementId   String               @map("pay_statement_id") @db.Uuid
  kind             PayStatementLineKind
  detail           String
  amountCentavos   Int                  @map("amount_centavos")
  position         Int                  @db.SmallInt
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(3)
  payStatement     PayStatement         @relation(fields: [payStatementId], references: [id], onDelete: Restrict)

  @@index([payStatementId, position])
  @@map("pay_statement_lines")
  @@schema("back_office")
}

model SalaryPayment {
  id                  String      @id @default(uuid()) @db.Uuid
  staffMemberId       String      @map("staff_member_id") @db.Uuid
  amountCentavos      Int         @map("amount_centavos")
  paidOn              DateTime    @map("paid_on") @db.Date
  recordedByAccountId String      @map("recorded_by_account_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  staffMember         StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  recordedByAccount   Account     @relation("SalaryPaymentRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: Restrict)
  payStatement        PayStatement?

  @@index([paidOn])
  @@index([staffMemberId, paidOn])
  @@index([recordedByAccountId])
  @@map("salary_payments")
  @@schema("back_office")
}

// BKO-005: the fixed-cost budget, one row per line. Contingencies are not a
// row; they are a percent of the subtotal, computed when the month is read.
model CostBudgetLine {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  monthlyCentavos  Int      @map("monthly_centavos")
  position         Int      @db.SmallInt
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("cost_budget_lines")
  @@schema("back_office")
}

model ExpenseCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  expenses  Expense[]

  @@map("expense_categories")
  @@schema("back_office")
}

model Expense {
  id                  String          @id @default(uuid()) @db.Uuid
  branchId            String          @map("branch_id") @db.Uuid
  expenseCategoryId   String          @map("expense_category_id") @db.Uuid
  amountCentavos      Int             @map("amount_centavos")
  incurredOn          DateTime        @map("incurred_on") @db.Date
  recordedByAccountId String          @map("recorded_by_account_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  expenseCategory     ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)
  recordedByAccount   Account         @relation("ExpenseRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: Restrict)

  @@index([branchId, incurredOn])
  @@index([incurredOn])
  @@index([expenseCategoryId])
  @@index([recordedByAccountId])
  @@map("expenses")
  @@schema("back_office")
}
