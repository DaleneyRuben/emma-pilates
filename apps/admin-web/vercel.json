  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "has": [{ "type": "host", "value": "emma-pilates-admin.vercel.app" }],
      "destination": "https://p01--api--mmps25fn9k9x.code.run/api/v1/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
